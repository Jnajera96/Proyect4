        </mxCell>
        <mxCell value="&lt;b&gt;GPU cloud opcional&lt;/b&gt;&lt;br&gt;Transformers / PyTorch&lt;br&gt;Preparación parcial; no ejecutada&lt;br&gt;No es dependencia del producto" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;strokeWidth=1.5;fontFamily=Helvetica;fontSize=16;spacing=12;align=center;verticalAlign=middle;fillColor=#FFF9E9;strokeColor=#B38B42;dashed=1;fontColor=#72591E;" vertex="1" id="gpu" parent="1">
          <mxGeometry as="geometry" y="880" height="110" width="360" x="1350" />
        </mxCell>
        <mxCell value="&lt;b&gt;Leyenda:&lt;/b&gt; línea continua = relación del sistema implementado · línea discontinua = preparación o conexión futura.&lt;br&gt;Model Lab parcial; no se afirma HF real, EXE, instalador ni preparación para producción. Productización permanece pausada." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#24374B;fontSize=17;fontSize=16;" vertex="1" id="legend" parent="1">
