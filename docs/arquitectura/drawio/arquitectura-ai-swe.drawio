        </mxCell>
        <mxCell value="&lt;b&gt;Usuario&lt;/b&gt;&lt;br&gt;Texto o voz · revisión y decisiones humanas" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;strokeWidth=1.5;fontFamily=Helvetica;fontSize=16;spacing=12;align=center;verticalAlign=middle;fillColor=#FFF3DA;strokeColor=#BC861F;fontColor=#704B10;" vertex="1" id="user" parent="1">
          <mxGeometry as="geometry" y="120" height="55" width="340" x="480" />
        </mxCell>
        <mxCell value="&lt;b&gt;Frontend React + TypeScript&lt;/b&gt;&lt;br&gt;Navegador · build Vite&lt;br&gt;Proyectos, runs, detalle, workflow,&lt;br&gt;seguridad, sesión y gates HITL" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;strokeWidth=1.5;fontFamily=Helvetica;fontSize=16;spacing=12;align=center;verticalAlign=middle;fillColor=#E6F1FF;strokeColor=#2374AB;fontColor=#173B59;" vertex="1" id="ui" parent="1">
          <mxGeometry as="geometry" y="260" height="145" width="280" x="80" />
        </mxCell>
        <mxCell value="&lt;b&gt;API FastAPI&lt;/b&gt;&lt;br&gt;REST + eventos SSE&lt;br&gt;Sirve frontend/dist en /app&lt;br&gt;Proyectos, runs, gates y transcripción" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;strokeWidth=1.5;fontFamily=Helvetica;fontSize=16;spacing=12;align=center;verticalAlign=middle;fillColor=#E6F1FF;strokeColor=#2374AB;fontColor=#173B59;" vertex="1" id="api" parent="1">
          <mxGeometry as="geometry" y="260" height="145" width="300" x="450" />
        </mxCell>
        <mxCell value="&lt;b&gt;RunEngine + RunWorker&lt;/b&gt;&lt;br&gt;Ejecución asíncrona&lt;br&gt;Reanudación por run&lt;br&gt;Eventos y control del ciclo de vida" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;strokeWidth=1.5;fontFamily=Helvetica;fontSize=16;spacing=12;align=center;verticalAlign=middle;fillColor=#E6F1FF;strokeColor=#2374AB;fontColor=#173B59;" vertex="1" id="engine" parent="1">
          <mxGeometry as="geometry" y="260" height="145" width="350" x="870" />
        </mxCell>
        <mxCell value="&lt;b&gt;Speech-to-Text opcional&lt;/b&gt;&lt;br&gt;FasterWhisperAdapter / fake de pruebas&lt;br&gt;Transcripción editable y confirmación&lt;br&gt;STT real aún sin verificar" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;strokeWidth=1.5;fontFamily=Helvetica;fontSize=16;spacing=12;align=center;verticalAlign=middle;fillColor=#F2F4F7;strokeColor=#8B96A5;fontColor=#354254;fontSize=14;" vertex="1" id="stt" parent="1">
          <mxGeometry as="geometry" y="470" height="155" width="280" x="80" />
        </mxCell>
        <mxCell value="&lt;b&gt;Persistencia SQLite&lt;/b&gt;&lt;br&gt;RunStore: proyectos, RunState,&lt;br&gt;eventos y resultados&lt;br&gt;Checkpoints LangGraph para reanudar" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;strokeWidth=1.5;fontFamily=Helvetica;fontSize=16;spacing=12;align=center;verticalAlign=middle;fillColor=#F0EAFE;strokeColor=#8062B0;fontColor=#4C3373;fontSize=15;" vertex="1" id="store" parent="1">
          <mxGeometry as="geometry" y="470" height="140" width="300" x="450" />
        </mxCell>
        <mxCell value="&lt;b&gt;Orquestación LangGraph&lt;/b&gt;&lt;br&gt;Analyst → HITL requisitos → Supervisor&lt;br&gt;Researcher determinista → Coder&lt;br&gt;Pruebas → Reviewer → HITL cambio" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;strokeWidth=1.5;fontFamily=Helvetica;fontSize=16;spacing=12;align=center;verticalAlign=middle;fillColor=#E6F1FF;strokeColor=#2374AB;fontColor=#173B59;" vertex="1" id="graph" parent="1">
          <mxGeometry as="geometry" y="470" height="150" width="350" x="870" />
        </mxCell>
        <mxCell value="&lt;b&gt;Controles transversales&lt;/b&gt;&lt;br&gt;Auth por API key opcional y roles&lt;br&gt;Contratos Pydantic · Policy Engine&lt;br&gt;Alcance/rutas protegidas · Budget&lt;br&gt;Redacción de secretos" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;strokeWidth=1.5;fontFamily=Helvetica;fontSize=16;spacing=12;align=center;verticalAlign=middle;fillColor=#F2F4F7;strokeColor=#8B96A5;fontColor=#354254;" vertex="1" id="security" parent="1">
          <mxGeometry as="geometry" y="680" height="170" width="280" x="80" />
        </mxCell>
        <mxCell value="&lt;b&gt;Entorno de ejecución&lt;/b&gt;&lt;br&gt;Worktree Git · Patcher · Test runner&lt;br&gt;Evidencia de pruebas y diff revisado&lt;br&gt;Confinamiento de escritura;&lt;br&gt;sin aislamiento completo de procesos/red" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;strokeWidth=1.5;fontFamily=Helvetica;fontSize=16;spacing=12;align=center;verticalAlign=middle;fillColor=#E5F4EC;strokeColor=#2D8257;fontColor=#164A32;" vertex="1" id="worktree" parent="1">
          <mxGeometry as="geometry" y="680" height="170" width="300" x="450" />
        </mxCell>
        <mxCell value="&lt;b&gt;ModelGateway&lt;/b&gt;&lt;br&gt;Esquema Pydantic validado localmente&lt;br&gt;Timeouts, retry, fallback y usage&lt;br&gt;Coste desconocido permanece desconocido" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;strokeWidth=1.5;fontFamily=Helvetica;fontSize=16;spacing=12;align=center;verticalAlign=middle;fillColor=#F0EAFE;strokeColor=#8062B0;fontColor=#4C3373;" vertex="1" id="gateway" parent="1">
          <mxGeometry as="geometry" y="690" height="140" width="350" x="870" />
        </mxCell>
        <mxCell value="&lt;b&gt;Adapters existentes&lt;/b&gt;&lt;br&gt;FakeModelAdapter para pruebas offline&lt;br&gt;OpenAICompatibleAdapter para HTTP&lt;br&gt;Proveedor real opt-in; no validado con HF" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;strokeWidth=1.5;fontFamily=Helvetica;fontSize=16;spacing=12;align=center;verticalAlign=middle;fillColor=#F0EAFE;strokeColor=#8062B0;fontColor=#4C3373;fontSize=14;" vertex="1" id="adapter" parent="1">
          <mxGeometry as="geometry" y="880" height="110" width="350" x="870" />
        </mxCell>
        <mxCell value="&lt;b&gt;Repositorio autorizado del usuario&lt;/b&gt;&lt;br&gt;Promoter aplica solo tras aprobación explícita&lt;br&gt;Valida política, diff y reproducción de bytes" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;strokeWidth=1.5;fontFamily=Helvetica;fontSize=16;spacing=12;align=center;verticalAlign=middle;fillColor=#E5F4EC;strokeColor=#2D8257;fontColor=#164A32;fontSize=14;" vertex="1" id="repo" parent="1">
          <mxGeometry as="geometry" y="920" height="115" width="300" x="450" />
        </mxCell>
        <mxCell value="&lt;b&gt;Jupyter / Hugging Face Model Lab&lt;/b&gt;&lt;br&gt;Notebook + tools/model_lab*.py&lt;br&gt;Descubrimiento público implementado&lt;br&gt;Casos y tests offline preparados" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;strokeWidth=1.5;fontFamily=Helvetica;fontSize=16;spacing=12;align=center;verticalAlign=middle;fillColor=#FFF9E9;strokeColor=#B38B42;dashed=1;fontColor=#72591E;" vertex="1" id="lab" parent="1">
