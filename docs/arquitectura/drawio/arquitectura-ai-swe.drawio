        </mxCell>
        <mxCell value="&lt;b&gt;Hugging Face Inference Providers&lt;/b&gt;&lt;br&gt;Endpoint OpenAI-compatible documentado&lt;br&gt;Benchmark real pendiente de token y&lt;br&gt;autorización de cuota/gasto" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;strokeWidth=1.5;fontFamily=Helvetica;fontSize=16;spacing=12;align=center;verticalAlign=middle;fillColor=#FFF9E9;strokeColor=#B38B42;dashed=1;fontColor=#72591E;" vertex="1" id="hf" parent="1">
