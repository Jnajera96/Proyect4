        <mxCell value="&lt;b&gt;RUNTIME LOCAL · SINGLE-USER · 127.0.0.1&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFCFF;strokeColor=#A7BDD4;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=18;spacingTop=12;fontFamily=Helvetica;fontSize=18;fontStyle=1;" vertex="1" id="local" parent="1">
