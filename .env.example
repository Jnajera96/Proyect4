# Variables de configuracion del sistema.
# Copiar a `.env` y rellenar los valores.
#
# REGLA: este archivo documenta NOMBRES, nunca valores. Los secretos no se
# almacenan en el repositorio (docs/01-arquitectura.md, seccion 16.4).
# Todas las variables llevan el prefijo AI_SWE_.
#
# Una variable presente pero VACIA equivale a no declararla: se usa el valor por
# defecto. Asi copiar este archivo tal cual a `.env` no rompe el arranque.
# Solo se documentan ajustes que el codigo **lee**: un ajuste declarado que nadie
# consume se cree aplicado y no lo esta. Las dos excepciones van marcadas como
# **NO IMPLEMENTADO**: se conservan porque el diseno las declara como propuesta,
# pero hoy no las lee ningun codigo y no se deben tomar por capacidades presentes.

# --- Servidor ----------------------------------------------------------------
# Puerto del bucle local.
# **La interfaz NO es configurable por entorno:** `python -m ai_swe` la fija en
# una constante (127.0.0.1), a proposito -no hay autenticacion y una ejecucion
# escribe codigo y lanza pruebas (ver src/ai_swe/__main__.py). En el contenedor
# es distinto: `docker-compose.yml` publica el puerto **solo en el bucle local del
# host** (`127.0.0.1:8000:8000`), y dentro del contenedor hay que escuchar en todas
# las interfaces para que el mapeo funcione. Lo que mantiene eso local es el mapeo
# del host, no la linea del contenedor.
AI_SWE_PORT=8000

# --- Proveedor de modelo -----------------------------------------------------
# openai | anthropic | local | otro
# El sistema NO necesita proveedor: arranca y el grafo se recorre sin clave.
# La clave solo se exige cuando se va a llamar al modelo, y el error es tipado y
# nombra el campo que falta, nunca su valor.
AI_SWE_MODEL_PROVIDER=openai
AI_SWE_MODEL_NAME=
# Opt-in: [] conserva el modo offline. Perfil hibrido: ["coder","reviewer"].
# Analyst y Supervisor siguen siendo deterministas al activar ese perfil.
AI_SWE_REMOTE_MODEL_ROLES=[]
# Modelo especifico del Reviewer. Vacio = usa AI_SWE_MODEL_NAME.
AI_SWE_REVIEWER_MODEL=
# NUNCA poner una clave real aqui. Dejar vacio o un marcador evidentemente falso.
AI_SWE_MODEL_API_KEY=
# Solo para proveedores locales (Ollama, vLLM):
AI_SWE_MODEL_BASE_URL=
# Tarifas publicadas por el proveedor, en SU moneda. Vacio por defecto: mientras
# no se declare, el coste de cada llamada es `None` ("no se sabe"), nunca 0.
# Copiar el precio de la pagina del proveedor; no inventarlo.
# Ejemplo con la forma exacta (valores de fantasia, sustituir por los reales):
# AI_SWE_MODEL_PRICING=[{"model":"gpt-4o-mini","input_per_1k":0.0,"output_per_1k":0.0,"currency":"USD"}]
AI_SWE_MODEL_PRICING=

# --- Almacen de estado -------------------------------------------------------
AI_SWE_STATE_DB_PATH=var/state.sqlite3
AI_SWE_WORKSPACE_ROOT=var/workspaces

# --- Alcance y seguridad -----------------------------------------------------
# Lista blanca de repositorios que el sistema puede tocar.
#   []  = sin restriccion adicional (modo local mono-usuario: la autorizacion es
#         que una persona registre el proyecto a mano).
#   [..] = SOLO se aceptan rutas dentro de esas. Registrar un proyecto o lanzar
#          una ejecucion contra otro repositorio devuelve 403.
AI_SWE_AUTHORIZED_REPOS=[]
# Enumeracion cerrada de objetivos de prueba ejecutables. `run_tests` solo
# acepta identificadores de esta lista, nunca comandos libres.
AI_SWE_ALLOWED_TEST_TARGETS=["pytest.unit","pytest.integration","ruff.check"]
# Enumeracion cerrada de paquetes instalables. Vacia = ninguno.
AI_SWE_ALLOWED_PACKAGES=[]
# Salida de red deseada para el entorno de ejecucion. **TODAVIA NO SE APLICA**:
# el aislamiento real de proceso llega en su propia fase. Hoy la ejecucion de
# pruebas hereda el entorno del proceso padre, con este valor o sin el.
AI_SWE_NETWORK_EGRESS_ENABLED=false
# Cabeceras `Host` que se aceptan. Cualquier otra devuelve 400 antes de llegar al
# manejador: es la defensa contra el envenenamiento de host. `localhost` y
# `127.0.0.1` son el bucle local; `testserver` lo anade el cliente de pruebas.
# Anadir los dominios reales antes de exponer el servicio.
AI_SWE_TRUSTED_HOSTS=["localhost","127.0.0.1","testserver"]

# --- Limites del borde (Fase 3) ---------------------------------------------
# Tamano maximo de audio aceptado en POST /transcriptions, en bytes. Se corta
# **mientras se lee**: pasar de aqui devuelve 413 sin cargar el fichero entero.
AI_SWE_MAX_AUDIO_BYTES=5242880
# Tamano maximo de pagina en los listados (`/runs`, `/projects`). Pedir mas
# devuelve 422: el tope es parte del contrato de la peticion, no una comprobacion
# a mano que alguien pueda olvidar.
AI_SWE_MAX_PAGE_SIZE=200
# Conexiones SSE abiertas a la vez. Cada flujo sondea el almacen cada 50 ms; sin
# tope, un cliente puede abrir cientos y dejar el proceso sin aire. Pasarse
# devuelve 503 con `Retry-After`, y el flujo es reanudable con `Last-Event-ID`.
AI_SWE_MAX_SSE_CONNECTIONS=16
# Limite de peticiones por cliente. **APAGADO por defecto**: en bucle local
# mono-usuario no protege de nadie y estorba a las pruebas. Encenderlo antes de
# exponer el servicio.
#   AI_SWE_RATE_LIMIT_ENABLED=true  +  AI_SWE_RATE_LIMIT_PER_MINUTE=N
AI_SWE_RATE_LIMIT_ENABLED=false
AI_SWE_RATE_LIMIT_PER_MINUTE=120

# --- Autenticacion (Fase 4) --------------------------------------------------
# Claves de API por rol, en forma de objeto JSON {"clave": "rol", ...}.
#   {}  = autenticacion DESACTIVADA (defecto): la API se comporta como en las
#         fases anteriores y el bucle local mono-usuario no cambia.
#   [..] = autenticacion ACTIVADA en toda la API menos GET /health, que sigue
#          abierto: un balanceador que recibe 401 marca el servicio caido.
#
# Roles (enumeracion cerrada; un rol inventado rompe el arranque a proposito):
#   reader    solo lectura.
#   operator  ciclo de vida de ejecuciones: crear, listar, transcribir, confirmar
#             requisitos, aprobar (promueve el parche al repositorio) y cancelar.
#   admin     todo lo anterior mas registrar proyectos: fija el `repo_path`
#             contra el que se ejecutara.
#
# La clave se manda en la cabecera `X-API-Key: <clave>` o como
# `Authorization: Bearer <clave>`. El flujo SSE (`GET /runs/{id}/events`) acepta
# ademas `?api_key=<clave>` porque `EventSource` no puede enviar cabeceras; es la
# unica excepcion y tiene un precio: la clave acaba en registros de acceso,
# historial y proxies. Pensada para una clave de lectura.
#
# **NUNCA poner una clave real aqui.** Este archivo documenta nombres, no valores.
# Generar claves largas y aleatorias (p. ej. `python -c "import secrets;
# print(secrets.token_urlsafe(32))"`) y guardarlas fuera del repositorio.
AI_SWE_API_KEYS={}

# --- Presupuesto -------------------------------------------------------------
# Estos valores son los que copia el `Budget` de cada ejecucion al crearse.
AI_SWE_MAX_TOKENS_PER_RUN=200000
AI_SWE_MAX_TOOL_CALLS_PER_RUN=60
AI_SWE_MAX_MODEL_CALLS_PER_RUN=120
AI_SWE_MAX_SECONDS_PER_RUN=900
AI_SWE_MAX_REVIEW_CYCLES=2
# Coste maximo en la moneda del proveedor. Vacio = sin limite declarado, que es
# distinto de cero: cero seria "no se permite gastar nada".
AI_SWE_MAX_COST_PER_RUN=

# --- Speech-to-Text (opcional) ----------------------------------------------
AI_SWE_STT_PROVIDER=faster-whisper
AI_SWE_STT_MODEL=large-v3
AI_SWE_STT_LANGUAGE=es
AI_SWE_STT_DEVICE=cpu
AI_SWE_STT_COMPUTE_TYPE=int8
# Modo instalado: seleccionar AI_SWE_RUNTIME_MODE=installed en el entorno del launcher.
# Carga %LOCALAPPDATA%/AISWESystem/config/.env; no lee .env del directorio de codigo.
# AI_SWE_STATE_DB_PATH, AI_SWE_WORKSPACE_ROOT, AI_SWE_LOG_DIR, AI_SWE_CACHE_DIR y
# AI_SWE_STT_DOWNLOAD_ROOT admiten rutas absolutas externas. Vacias = defaults de usuario.
AI_SWE_STT_CONFIDENCE_WARN_THRESHOLD=0.75
# --- Salida por voz (NO IMPLEMENTADO) ----------------------------------------
# **NO IMPLEMENTADO.** No existe adaptador de TTS ni consumidor de este ajuste.
# Se conserva porque `docs/01-arquitectura.md` la declara como propuesta (`[PROP]`),
# no como requisito. El informe textual es siempre la via de salida.
AI_SWE_TTS_ENABLED=false

# --- Observabilidad ----------------------------------------------------------
AI_SWE_LOG_LEVEL=INFO
# **NO IMPLEMENTADO.** No hay integracion con Langfuse: ni `ENABLED` ni `HOST` los
# lee ningun codigo. Llega en la fase de observabilidad.
AI_SWE_LANGFUSE_ENABLED=false
AI_SWE_LANGFUSE_HOST=http://localhost:3000
# Las claves SI se usan: las registra el redactor central para que una clave no
# acabe en un log. Se dejan documentadas por eso.
AI_SWE_LANGFUSE_PUBLIC_KEY=
AI_SWE_LANGFUSE_SECRET_KEY=

# Cuotas del runner Windows por objetivo (no son aislamiento de archivos/red).
AI_SWE_RUNNER_LIMITS={"max_processes":16,"memory_mb":1024,"cpu_seconds":600}

# --- Pruebas opt-in ----------------------------------------------------------
# La suite estandar NO usa red ni credenciales: estas pruebas se SALTAN salvo que
# se activen explicitamente. Nunca pegar una clave en el chat.
# OJO: estas tres NO las lee `Settings`, sino que las consulta la propia prueba
# en el entorno del proceso, asi que hay que **exportarlas** en la shell; no basta
# con dejarlas en `.env`.
# Prueba real contra el proveedor (gasta dinero y necesita clave + modelo):
AI_SWE_RUN_REAL_PROVIDER_TESTS=0
# Prueba real de transcripcion local (necesita el extra `voice` y descarga un modelo):
AI_SWE_RUN_REAL_STT_TESTS=0
# Modelo pequeno para esa prueba, para no descargar uno grande en cada ejecucion:
AI_SWE_STT_TEST_MODEL=tiny
